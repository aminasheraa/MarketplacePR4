<Page x:Class="MarketplacePR4.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplacePR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage" Background="White" Loaded="CartPage_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border CornerRadius="8" Width="150" Height="30" Margin="10" Background="#9370DB">
                <Button x:Name="BackBtn" Content="Назад" Height="30" Width="120" FontSize="16" Background="Transparent" BorderThickness="0" FontFamily="Book Antiqua" Click="BackBtn_Click"/>
            </Border>
            <TextBlock Text="Корзина" FontSize="25" Margin="170,0,0,0" FontFamily="Book Antiqua" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        
        <ListBox Grid.Row="1" x:Name="ProductsLB" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"  d:ItemsSource="{d:SampleData ItemCount=2}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border  Background="#d0bcfc" HorizontalAlignment="Stretch" Width="750" VerticalAlignment="Center" BorderThickness="1" CornerRadius="8" Padding="10" Margin="10" >
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="8"  HorizontalAlignment="Center" Margin="10" Background="White">
                                <Image Margin="5" Source="{Binding Image}" Stretch="Uniform" Height="100" Width="100" ToolTip="Картинка товара"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="Bold" Margin="5" ToolTip="Название товара" FontSize="20" FontFamily="Book Antiqua"/>
                                <TextBlock Text="{Binding Price, StringFormat=Цена: {0}}" TextWrapping="Wrap" Margin="5" ToolTip="Цена товара" FontFamily="Book Antiqua" FontSize="18"/>

                                <Border CornerRadius="8" Width="80" Height="30" Margin="10" Background="White" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="MinusBtn" Content="-" Background="Transparent" Height="20" Width="20" FontFamily="Book Antiqua" BorderThickness="0" FontSize="16" Margin="2"/>
                                        <TextBlock x:Name="QuantityTb" Text="" VerticalAlignment="Center" Margin="2" FontFamily="Book Antiqua" FontSize="16"/>
                                        <Button x:Name="AddBtn" Content="+" Background="Transparent" Height="20" Width="20" BorderThickness="0" FontSize="16" Margin="2" FontFamily="Book Antiqua"/>
                                    </StackPanel>

                                </Border>
                                <Border CornerRadius="8" Width="120" Height="30" Margin="10" Background="PaleVioletRed">
                                    <Button x:Name="DeleteBtn" Content="Удалить" Background="Transparent" BorderThickness="0" FontFamily="Book Antiqua" FontSize="14" Click="DeleteBtn_Click"/>
                                </Border>
                            </StackPanel>
                            
                        </StackPanel>

                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBlock Text="К оформлению: " FontSize="18" VerticalAlignment="Center" FontFamily="Book Antiqua"/>
            <TextBlock Text="" x:Name="TotalQuantityTb" FontSize="18" VerticalAlignment="Center" FontFamily="Book Antiqua"/>
            <TextBlock Text="" x:Name="PriceTb" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Book Antiqua" />
            <Border CornerRadius="8" Width="150" Height="30" Margin="10" Background="#9370DB">
                <Button x:Name="OrderBtn" Content="Оформить заказ"  Height="30" Width="150" FontSize="16" Background="Transparent" BorderThickness="0" FontFamily="Book Antiqua" Click="OrderBtn_Click"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
