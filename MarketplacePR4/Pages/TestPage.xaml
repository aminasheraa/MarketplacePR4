<Page x:Class="MarketplacePR4.Pages.TestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplacePR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="White"
      Title="TestPage">

    <Grid>
        <StackPanel Margin="30" VerticalAlignment="Center">
            <Button x:Name="savedBtn" Content="Избранное" Margin="5" Click="savedBtn_Click"/>
            <Button x:Name="ordersListBtn" Content="Заказы" Margin="5" Click="ordersListBtn_Click"/>
            <Button x:Name="cartBtn" Content="Корзина" Margin="5" Click="cartBtn_Click"/>
            <Button x:Name="reviewsBtn" Content="Отзывы" Margin="5" Click="reviewsBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
