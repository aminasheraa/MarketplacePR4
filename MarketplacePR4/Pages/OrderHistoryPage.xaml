<Page x:Class="MarketplacePR4.Pages.OrderHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplacePR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderHistoryPage" Background="White" Loaded="OrderHistoryPage_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border CornerRadius="8" Width="150" Height="30" Margin="10" Background="#9370DB">
                <Button x:Name="BackBtn" Content="Назад" Height="30" Width="120" FontSize="16" Background="Transparent" BorderThickness="0" FontFamily="Book Antiqua" Click="BackBtn_Click" Margin="15,0,15,0" VerticalAlignment="Top"/>
            </Border>
            <TextBlock Text="Мои заказы" FontSize="25" Margin="150,0,0,0" FontFamily="Book Antiqua" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="OrdersLB" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
<ListBox.ItemTemplate>
    <DataTemplate>
        <Border Width="750"
                Background="#d0bcfc"
                HorizontalAlignment="Stretch"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="10">

            <StackPanel>
                <TextBlock Text="{Binding ID, StringFormat='Заказ № {0}'}"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="Book Antiqua"
                           Margin="5"/>

                <TextBlock Text="{Binding DateOfOrder, StringFormat='Дата оформления: {0:dd.MM.yyyy}'}"
                           FontSize="16"
                           FontFamily="Book Antiqua"
                           Margin="5"/>

                <TextBlock Text="{Binding TotalPrice, StringFormat='Итоговая стоимость: {0} руб.'}"
                           FontSize="18"
                           FontWeight="Bold"
                           FontFamily="Book Antiqua"
                           Margin="5"/>

                <TextBlock Text="{Binding StatusID, StringFormat='Статус заказа (ID): {0}'}"
                           FontSize="16"
                           FontFamily="Book Antiqua"
                           Margin="5"/>

                <TextBlock Text="{Binding Adress, StringFormat='Адрес доставки: {0}'}"
                           FontSize="16"
                           FontFamily="Book Antiqua"
                           TextWrapping="Wrap"
                           Margin="5"/>

                <Border Height="1" Background="#9370DB" Margin="5,10"/>

                <TextBlock Text="Товары в заказе:"
                           FontSize="19"
                           FontWeight="Bold"
                           FontFamily="Book Antiqua"
                           Margin="5"/>

                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="5">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            CornerRadius="8"
                                            Background="White"
                                            Margin="5">
                                        <Image Source="{Binding Image}"
                                               Height="85"
                                               Width="85"
                                               Stretch="Uniform"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="10,5">

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   FontFamily="Book Antiqua"
                                                   TextWrapping="Wrap"
                                                   Margin="5"/>

                                        <TextBlock Text="{Binding Price, StringFormat='Цена: {0} руб.'}"
                                                   FontSize="16"
                                                   FontFamily="Book Antiqua"
                                                   Margin="5"/>

                                        <TextBlock Text="{Binding Quantity, StringFormat='Количество: {0} шт.'}"
                                                   FontSize="16"
                                                   FontFamily="Book Antiqua"
                                                   Margin="5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>
</ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
