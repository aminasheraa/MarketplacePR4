<Page x:Class="MarketplacePR4.Pages.SavedProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplacePR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SavedProductPage"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Избранное" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SavedProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#8e5081" BorderThickness="3" CornerRadius="3" 
                                Padding="10" Margin="0,0,0,10" Background="#326969">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="80" Height="80" Background="#EEEEEE" CornerRadius="4" 
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding Pictire}" Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="White"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PriceText}" FontSize="15" Margin="0,4,0,0" Foreground="White"/>
                                    <TextBlock Text="{Binding RatingText}" Foreground="White"/>
                                    <TextBlock Text="{Binding StockText}" Foreground="{Binding StockBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="В корзину" Width="110" Height="30" 
                                            IsEnabled="{Binding CanBuy}" Click="ToCart_Click"/>
                                    <Button Content="Удалить" Width="110" Height="30" Margin="0,8,0,0"
                                            Click="Remove_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="InfoText" Grid.Row="1" FontSize="16" Foreground="Gray"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
