<Page x:Class="MarketplacePR4.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplacePR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid>
        <Border Width="340" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#8e5081"
                BorderThickness="6" CornerRadius="6" Background="#326969">
            <StackPanel>
                <TextBlock Text="Регистрация" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" 
                           Foreground="White" Margin="0,0,0,20"/>

                <TextBlock Text="Фамиля и имя:" Foreground="White" FontWeight="Bold"/>
                <TextBox x:Name="NameBox" Height="25" MaxLength="50" Margin="0,4,0,12" 
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Логин" Foreground="White" FontWeight="Bold"/>
                <TextBox x:Name="LoginBox" Height="25" MaxLength="50" Margin="0,4,0,12" 
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Введите пароль" Foreground="White" FontWeight="Bold"/>
                <PasswordBox x:Name="PasswordBox" Height="25" MaxLength="72" Margin="0,4,0,12"
                             VerticalContentAlignment="Center"/>

                <TextBlock Text="Подтвердите пароль" Foreground="White" FontWeight="Bold"/>
                <PasswordBox x:Name="ReapeatBox" Height="25" MaxLength="72" Margin="0,4,0,12"
                             VerticalContentAlignment="Center"/>

                <TextBlock x:Name="ErrorText" Foreground="#C00000" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Button x:Name="RegisterBtn" Content="Зарегистрироваться" Height="34" IsDefault="True" 
                        Background="#696932" Foreground="White"
                        Click="RegisterBtn_Click"/>

                <Button Content="Уже есть аккаунт? Войти" Margin="0,10,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        Cursor="Hand" Click="ToLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
 