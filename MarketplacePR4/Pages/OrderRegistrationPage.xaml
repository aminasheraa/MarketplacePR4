<Page x:Class="MarketplacePR4.Pages.OrderRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MarketplacePR4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderRegistrationPage" Background="White" Loaded="OrderRegistrationPage_Loaded">

    <Grid>
        <Border Width="650" Height="430" Background="#d0bcfc" HorizontalAlignment="Stretch" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Оформление заказа" FontSize="25" FontFamily="Book Antiqua" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Содержимое заказа: "  FontSize="18" FontFamily="Book Antiqua" />
                <ListBox d:ItemsSource="{d:SampleData ItemCount=5}"  x:Name="OrderProductsLB" Height="190" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"> 
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Padding="8" Margin="5" Width="160">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="90"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="8" Background="White" Margin="2">
                                        <Image Source="{Binding Product.Image}" Height="85" Width="85" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="10,5">
                                        <TextBlock Text="{Binding Product.Name}" FontSize="16" FontWeight="Bold" FontFamily="Book Antiqua" TextWrapping="Wrap" Margin="2"/>
                                        <TextBlock Text="{Binding Product.Price, StringFormat='Цена: {0} руб.'}" FontSize="14" FontFamily="Book Antiqua" Margin="2"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat='Количество: {0} шт.'}" FontSize="14" FontFamily="Book Antiqua" Margin="2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Сумма к оплате: "  FontSize="18" Margin="5" FontFamily="Book Antiqua" x:Name="TotalPriceTB"/>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Выберите способ получения заказа: " FontSize="18" FontFamily="Book Antiqua" />
                    <ComboBox x:Name="TypeOfReceivingCB" Height="25" Width="120" Margin="5,0,0,0" DisplayMemberPath="Name" SelectionChanged="TypeOfReceivingCB_SelectionChanged"/>
                </StackPanel>
                <StackPanel x:Name="PickUpPointSP" Visibility="Collapsed" Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Выберите пункт выдачи: "  FontSize="18" FontFamily="Book Antiqua"/>
                    <ComboBox x:Name="PickUpPointCB" Height="25" Width="120" Margin="5,0,0,0" DisplayMemberPath="Address"/>
                </StackPanel>
                <StackPanel x:Name="DeliverySP" Visibility="Collapsed" Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Введите адрес для доставки: " FontSize="18" FontFamily="Book Antiqua"/>
                    <TextBox x:Name="AddressTB" Height="25" Width="120" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Border CornerRadius="8" Width="150" Height="30" Margin="10" Background="#9370DB">
                        <Button x:Name="CancelBtn" Content="Отмена" Height="30" Width="120" FontSize="16" Background="Transparent" BorderThickness="0" FontFamily="Book Antiqua" Margin="15,0,0,0" HorizontalAlignment="Left" Click="CancelBtn_Click"/>
                    </Border>
                    <Border CornerRadius="8" Width="150" Height="30" Margin="10" Background="#9370DB">
                        <Button x:Name="OrderBtn" Content="Оформить заказ" Height="30" Width="140" FontSize="16" Background="Transparent" BorderThickness="0" FontFamily="Book Antiqua" Margin="5,0,0,0" Click="OrderBtn_Click"/>
                    </Border>
                </StackPanel>
            </StackPanel>
            
        </Border>
    </Grid>
</Page>
